@echo off
REM ============================================================================
REM   ROXAS MAPPER - ALL-IN-ONE INSTALLER
REM   Creates RoxasMapper.py, installs Playwright, then removes itself
REM ============================================================================

setlocal enabledelayedexpansion
title Roxas Mapper - Setup Wizard
color 0B
cls

echo.
echo ============================================================================
echo   ROXAS MAPPER - SETUP WIZARD
echo ============================================================================
echo.
echo This installer will:
echo   1. Check Python installation
echo   2. Create RoxasMapper.py
echo   3. Install Playwright (browser automation)
echo   4. Download Chromium browser
echo   5. Verify everything works
echo.
echo Press any key to start...
pause >nul
cls

echo.
echo [STEP 1/5] Checking Python installation...
echo.
python --version >nul 2>&1
if errorlevel 1 (
    cls
    color 0C
    echo.
    echo ============================================================================
    echo   ERROR: Python is NOT installed!
    echo ============================================================================
    echo.
    echo Python 3.8 or higher is required.
    echo.
    echo Download from: https://www.python.org/downloads/
    echo.
    echo IMPORTANT: During installation, MUST CHECK:
    echo    "Add Python to PATH"
    echo.
    echo After installing Python, run RMInstaller.bat again.
    echo.
    pause
    exit /b 1
)
for /f "tokens=*" %%i in ('python --version') do set PYTHON_VERSION=%%i
echo [OK] Found: %PYTHON_VERSION%
echo.

echo [STEP 2/5] Creating RoxasMapper.py...
echo.
if exist "%~dp0RoxasMapper.b64" del /f /q "%~dp0RoxasMapper.b64" >nul 2>&1
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"
echo >>"%~dp0RoxasMapper.b64"

certutil -decode "%~dp0RoxasMapper.b64" "%~dp0RoxasMapper.py" >nul 2>&1
if errorlevel 1 (
    color 0C
    echo [ERROR] Failed to create RoxasMapper.py
    echo.
    pause
    exit /b 1
)
del /f /q "%~dp0RoxasMapper.b64" >nul 2>&1
echo [OK] RoxasMapper.py created
echo.

echo [STEP 3/5] Installing Playwright...
echo This may take 2-3 minutes...
echo.
python -m pip install --upgrade pip --quiet >nul 2>&1
python -m pip install playwright --upgrade --quiet --no-warn-script-location
if errorlevel 1 (
    echo Retrying without cache...
    python -m pip install playwright --no-cache-dir --upgrade --quiet --no-warn-script-location
    if errorlevel 1 (
        python -m pip install playwright==1.40.0 --force-reinstall --quiet --no-warn-script-location
        if errorlevel 1 (
            color 0C
            echo [ERROR] Failed to install Playwright
            echo Try restarting your computer and running RMInstaller.bat again.
            pause
            exit /b 1
        )
    )
)
echo [OK] Playwright installed
echo.

echo [STEP 4/5] Installing Chromium browser...
echo This may take 3-5 minutes (downloading ~150MB)...
echo.
python -m playwright install chromium
if errorlevel 1 (
    echo Trying full browser install...
    python -m playwright install
)
echo [OK] Chromium browser installed
echo.

echo [STEP 5/5] Verifying installation...
echo.
python -c "from playwright.sync_api import sync_playwright; sync_playwright()" >nul 2>&1
if errorlevel 1 (
    echo Fixing installation...
    python -m pip install playwright --force-reinstall --no-cache-dir --quiet
    python -m playwright install chromium --quiet >nul 2>&1
    python -c "from playwright.sync_api import sync_playwright; sync_playwright()" >nul 2>&1
    if errorlevel 1 (
        color 0C
        echo [ERROR] Playwright verification failed
        echo Restart your computer and run RMInstaller.bat again.
        pause
        exit /b 1
    )
)
echo [OK] Playwright verified and ready!
echo.

cls
color 0B
echo.
echo ============================================================================
echo   SUCCESS! INSTALLATION COMPLETE!
echo ============================================================================
echo.
echo Installation verified:
echo   [CHECK] Python %PYTHON_VERSION%
echo   [CHECK] RoxasMapper.py created
echo   [CHECK] Playwright installed
echo   [CHECK] Chromium browser ready
echo.
echo ============================================================================
echo   ROXAS MAPPER IS NOW READY TO USE!
echo ============================================================================
echo.
echo How to run:
echo   - Double-click: RoxasMapper.py
echo   - Command line: python RoxasMapper.py
echo.
echo Follow for updates:
echo   Discord: @litwolf
echo   X: @LitwolfYT
echo   YouTube: @LitwolfYT
echo   TikTok: @fnroxas
echo.
echo ============================================================================
echo.
echo This installer will now clean itself up.
echo.
echo Cleaning up in 10 seconds...
timeout /t 10
echo.
echo [OK] Cleanup complete. Only RoxasMapper.py remains.
echo.
echo Enjoy Roxas Mapper!
echo.
timeout /t 3 >nul

REM Self-delete this batch file (leaves RoxasMapper.py behind)
start "" /b cmd /c "timeout /t 1 >nul & del /f /q "%~f0""
exit
